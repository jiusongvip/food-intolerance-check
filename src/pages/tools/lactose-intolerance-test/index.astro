---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { Image } from 'astro:assets';
import dairyImage from '../../../assets/images/dairy-milk.jpg';
---
<BaseLayout title="Lactose Intolerance Checker - Free Online Self-Assessment" description="Think you might be lactose intolerant? Use our free lactose intolerance checker to explore your symptoms. Educational tool only — not a medical diagnosis." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Lactose Intolerance Checker', href: '/tools/lactose-intolerance-test' }]}">
<Header />
<main>
<section class="pt-16 pb-8 md:pt-24 px-4 sm:px-6 max-w-6xl mx-auto">
<div class="max-w-2xl mx-auto text-center">
<h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-slate-900 leading-none mb-4">Lactose Intolerance Checker</h1>
<p class="text-lg text-slate-500 max-w-lg mx-auto">Answer 5 questions about your dairy experiences. Educational only - not a medical diagnosis.</p>
</div>
<div class="mt-8 max-w-2xl mx-auto"><Image src={dairyImage} alt="Dairy products including milk, cheese, and yogurt" class="w-full h-auto rounded-xl" width={800} height={450} loading="lazy" format="webp" /></div>
</section>
<section class="pb-16 md:pb-24 px-4 sm:px-6 max-w-6xl mx-auto"><div class="max-w-xl mx-auto">
<h2 class="text-2xl font-semibold text-slate-900 mb-4 text-center">Take the Assessment</h2>
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">
<p class="text-center text-slate-400 text-sm">Select your answers below to get your result.</p>
<div class="space-y-6 mt-6" id="lactose-quiz"></div>
<div id="lactose-result" class="hidden"></div>
</div>
<div class="mt-8 bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-800">This tool does NOT diagnose disease. Always consult your GP or a dietitian.</div>
<h2 class="text-2xl font-semibold text-slate-900 mt-10 mb-3">About This Checker</h2>
<p class="text-slate-600 text-sm mb-4">This lactose intolerance checker asks about your experiences with dairy products — milk, cheese, yogurt, and ice cream. Based on your answers, it suggests whether your symptoms are consistent with lactose intolerance and recommends appropriate next steps such as keeping a food diary, trying an elimination diet, or asking your GP about a hydrogen breath test.</p>
<p class="text-slate-600 text-sm">Remember: this is an educational self-assessment only. A hydrogen breath test supervised by your GP is the gold standard for confirming lactose intolerance.</p>
<h2 class="text-2xl font-semibold text-slate-900 mt-10 mb-3">Related Resources</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
<a href="/guides/test-guide" class="block bg-slate-50 border border-slate-200 rounded-lg p-4 hover:border-brand-300 transition-colors no-underline"><p class="text-sm font-medium text-slate-900 mb-1">Testing Guide</p><p class="text-xs text-slate-500">Compare breath tests, IgG tests, and elimination diets.</p></a>
<a href="/tools/food-diary" class="block bg-slate-50 border border-slate-200 rounded-lg p-4 hover:border-brand-300 transition-colors no-underline"><p class="text-sm font-medium text-slate-900 mb-1">Food Diary</p><p class="text-xs text-slate-500">Track meals and symptoms to spot dairy patterns.</p></a>
<a href="/blog/elimination-diet-guide" class="block bg-slate-50 border border-slate-200 rounded-lg p-4 hover:border-brand-300 transition-colors no-underline"><p class="text-sm font-medium text-slate-900 mb-1">Elimination Diet Guide</p><p class="text-xs text-slate-500">Step-by-step protocol to confirm lactose triggers.</p></a>
<a href="/symptoms" class="block bg-slate-50 border border-slate-200 rounded-lg p-4 hover:border-brand-300 transition-colors no-underline"><p class="text-sm font-medium text-slate-900 mb-1">Symptoms Overview</p><p class="text-xs text-slate-500">Common food intolerance symptoms to watch for.</p></a>
</div>
</div></section>
</main>
<Footer />
</BaseLayout>
<script is:inline src="/js/lactose-checker.js"></script>
