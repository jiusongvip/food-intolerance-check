---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from 'astro:assets';
import faqImage from '../../assets/images/faq-questions.webp';
---
<BaseLayout title="Food Intolerance FAQ - Testing & Symptoms - FoodCheck" description="Common questions about food intolerances, testing methods, elimination diets, and how our checker tool works. Evidence-based answers to help you get started." breadcrumbs={[{ label: 'FAQ', href: '/faq' }]}">
<Header /><main class="max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-24">
<h1 class="text-4xl font-semibold text-slate-900 mb-4 tracking-tight">Food Intolerance FAQ</h1>
<p class="text-lg text-slate-500 mb-10">Common questions about food intolerances and how to use our tools.</p>
<Image src={faqImage} alt="Person researching food intolerance questions and answers" class="w-full h-auto rounded-xl mb-10 max-w-2xl" width={800} height={450} loading="lazy" format="webp" />
<h2 class="text-2xl font-semibold text-slate-900 mb-5">Common Questions About Food Intolerance</h2>
<div class="space-y-2">
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">Is this checker a medical diagnosis?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">No. This tool is for educational purposes only. It does not diagnose any medical condition. Always consult your GP or a registered dietitian for proper diagnosis and treatment.</div></details>
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">What is a food intolerance?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">A food intolerance is difficulty digesting certain foods, leading to unpleasant physical reactions. Unlike food allergies, intolerances do not involve the immune system and are generally not life-threatening.</div></details>
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">How is it different from a food allergy?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">Food allergies involve the immune system and can cause severe, potentially life-threatening reactions (anaphylaxis). Food intolerances affect the digestive system. <a href="/guides/intolerance-vs-allergy" class="text-brand-600 hover:text-brand-700 underline">Read our full comparison guide.</a></div></details>
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">What common foods cause intolerance?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">Common trigger foods include dairy (lactose), wheat/gluten, eggs, soy, nuts, shellfish, fermented foods (histamine), and certain fruits (fructose). Use our <a href="/" class="text-brand-600 hover:text-brand-700 underline">Food Intolerance Checker</a> to explore possible triggers.</div></details>
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">How do I get properly tested?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">Speak to your GP first. They may recommend a hydrogen breath test, an elimination diet supervised by a dietitian, or other evidence-based approaches. <a href="/guides/test-guide" class="text-brand-600 hover:text-brand-700 underline">See our testing guide.</a></div></details>
<details class="group bg-white border border-slate-200 rounded-xl"><summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none"><h3 class="font-medium text-slate-900 text-sm flex-1">Is my data collected?</h3><svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary><div class="px-5 pb-4 text-sm text-slate-500 leading-relaxed">No. All tools on FoodCheck run entirely in your browser. We do not collect, store, or share any data. The Food Diary uses localStorage, which stays on your device.</div></details>
</div>

<h2 class="text-2xl font-semibold text-slate-900 mt-10 mb-5">References</h2>
<ul class="list-disc list-inside text-slate-500 text-sm space-y-1 mb-4">
  <li>NHS UK — Food Intolerance (2024)</li>
  <li>British Dietetic Association (BDA) — Food Intolerance Fact Sheet</li>
  <li>American Academy of Allergy, Asthma & Immunology (AAAAI) — Food Allergy</li>
  <li>Guts UK — Food Intolerance and Digestive Health</li>
</ul>
</main>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this checker a medical diagnosis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. This tool is for educational purposes only. It does not diagnose any medical condition. Always consult your GP or a registered dietitian for proper diagnosis and treatment."
      }
    },
    {
      "@type": "Question",
      "name": "What is a food intolerance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A food intolerance is difficulty digesting certain foods, leading to unpleasant physical reactions. Unlike food allergies, intolerances do not involve the immune system and are generally not life-threatening."
      }
    },
    {
      "@type": "Question",
      "name": "How is it different from a food allergy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Food allergies involve the immune system and can cause severe, potentially life-threatening reactions (anaphylaxis). Food intolerances affect the digestive system."
      }
    },
    {
      "@type": "Question",
      "name": "What common foods cause intolerance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common trigger foods include dairy (lactose), wheat/gluten, eggs, soy, nuts, shellfish, fermented foods (histamine), and certain fruits (fructose)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get properly tested?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Speak to your GP first. They may recommend a hydrogen breath test, an elimination diet supervised by a dietitian, or other evidence-based approaches."
      }
    },
    {
      "@type": "Question",
      "name": "Is my data collected?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All tools on FoodCheck run entirely in your browser. We do not collect, store, or share any data. The Food Diary uses localStorage, which stays on your device."
      }
    }
  ]
}
</script>
<Footer /></BaseLayout>
