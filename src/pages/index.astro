---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-healthy.webp';
---

<BaseLayout title="Food Intolerance Checker - Free Self-Test - FoodCheck" description="Use our free food intolerance checker to explore which foods may be linked to your symptoms. Educational tool only — no medical diagnosis. No sign-up required.">
  <Header />
  <main>
    <section class="pt-20 pb-8 md:pt-28 md:pb-12 px-4 sm:px-6 max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-xs font-medium tracking-widest uppercase text-brand-600 mb-4">Free Self-Assessment Tool</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-slate-900 leading-none mb-4">Food Intolerance Checker</h1>
        <p class="text-base md:text-lg text-slate-500 max-w-lg mx-auto">A private, 3-step self-assessment to help you identify possible trigger foods. No sign-up. No data collected.</p>
      </div>
      <div class="mt-10 max-w-3xl mx-auto">
        <Image src={heroImage} alt="Fresh healthy food ingredients arranged on a table" class="w-full h-auto rounded-2xl shadow-sm" width={800} height={450} loading="eager" format="webp" fetchpriority="high" />
      </div>
    </section>

    <section class="pb-16 md:pb-24 px-4 sm:px-6 max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto" id="checker-app">
        <div class="flex items-center justify-between mb-6 px-1" id="step-labels">
          <div class="flex flex-col items-center gap-1 transition-all duration-300" id="label-1">
            <span class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-brand-600 text-white shadow-sm shadow-brand-200">1</span>
            <span class="text-xs font-medium text-brand-700 hidden sm:block">Symptoms</span>
          </div>
          <div class="flex-1 mx-3 relative h-0.5 bg-slate-200 rounded-full overflow-hidden"><div class="absolute inset-0 bg-brand-500 rounded-full transition-all duration-500 ease-out" style="width:0%" id="bar-1"></div></div>
          <div class="flex flex-col items-center gap-1 transition-all duration-300" id="label-2">
            <span class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-400">2</span>
            <span class="text-xs font-medium text-slate-400 hidden sm:block">Timing</span>
          </div>
          <div class="flex-1 mx-3 relative h-0.5 bg-slate-200 rounded-full overflow-hidden"><div class="absolute inset-0 bg-brand-500 rounded-full transition-all duration-500 ease-out" style="width:0%" id="bar-2"></div></div>
          <div class="flex flex-col items-center gap-1 transition-all duration-300" id="label-3">
            <span class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-400">3</span>
            <span class="text-xs font-medium text-slate-400 hidden sm:block">Foods</span>
          </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="px-6 sm:px-8 py-8" id="step-content"></div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-xs font-medium tracking-widest uppercase text-brand-600 mb-3">Why FoodCheck</p>
          <h2 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-3">Why Use a Food Intolerance Checker?</h2>
          <p class="text-slate-500 max-w-xl mx-auto">Food intolerances affect up to 20% of the population (NHS, 2024). Our checker helps you start the conversation with your healthcare provider armed with better questions.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="bg-white border border-slate-200 rounded-xl p-6 group hover:border-brand-200 hover:shadow-sm transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center mb-5 group-hover:bg-brand-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Fast Self-Assessment</h3><p class="text-sm text-slate-500 leading-relaxed">Answer a few questions and get possible intolerance matches in under 2 minutes.</p></div><div class="bg-white border border-slate-200 rounded-xl p-6 group hover:border-brand-200 hover:shadow-sm transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center mb-5 group-hover:bg-brand-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Private & No Sign-Up</h3><p class="text-sm text-slate-500 leading-relaxed">Everything runs in your browser. No data collected, stored, or shared.</p></div><div class="bg-white border border-slate-200 rounded-xl p-6 group hover:border-brand-200 hover:shadow-sm transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center mb-5 group-hover:bg-brand-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Actionable Next Steps</h3><p class="text-sm text-slate-500 leading-relaxed">Clear recommendations: elimination diets, food diaries, and when to speak to your GP.</p></div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-xs font-medium tracking-widest uppercase text-brand-600 mb-3">Explore by Type</p>
          <h2 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-3">Which Intolerance Types Can You Check?</h2>
          <p class="text-slate-500 max-w-xl mx-auto">Each checker includes focused questions tailored to that specific intolerance, based on clinical symptom patterns.</p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/tools/lactose-intolerance-test" class="group flex flex-col bg-slate-50 border border-slate-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 no-underline"><span class="text-3xl mb-3">🥛</span><h3 class="font-semibold text-slate-900 group-hover:text-brand-700 transition-colors mb-1">Lactose</h3><p class="text-sm text-slate-500 leading-relaxed">Dairy products, milk, cheese & yogurt</p></a><a href="/tools/gluten-intolerance-test" class="group flex flex-col bg-slate-50 border border-slate-200 rounded-xl p-6 hover:border-amber-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 no-underline"><span class="text-3xl mb-3">🌾</span><h3 class="font-semibold text-slate-900 group-hover:text-amber-700 transition-colors mb-1">Gluten</h3><p class="text-sm text-slate-500 leading-relaxed">Wheat, barley, rye & baked goods</p></a><a href="/tools/histamine-intolerance-test" class="group flex flex-col bg-slate-50 border border-slate-200 rounded-xl p-6 hover:border-red-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 no-underline"><span class="text-3xl mb-3">🍷</span><h3 class="font-semibold text-slate-900 group-hover:text-red-700 transition-colors mb-1">Histamine</h3><p class="text-sm text-slate-500 leading-relaxed">Aged cheese, wine, cured meats</p></a><a href="/tools/fructose-intolerance-test" class="group flex flex-col bg-slate-50 border border-slate-200 rounded-xl p-6 hover:border-orange-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 no-underline"><span class="text-3xl mb-3">🍎</span><h3 class="font-semibold text-slate-900 group-hover:text-orange-700 transition-colors mb-1">Fructose</h3><p class="text-sm text-slate-500 leading-relaxed">Fruits, honey & sweeteners</p></a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-xs font-medium tracking-widest uppercase text-brand-600 mb-3">More Tools</p>
          <h2 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-3">How Can You Track and Manage Symptoms?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          <a href="/tools/food-diary" class="group block bg-white border border-slate-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-300 no-underline"><div class="w-11 h-11 rounded-xl bg-purple-50 flex items-center justify-center mb-5 group-hover:bg-purple-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Food Diary</h3><p class="text-sm text-slate-500 leading-relaxed">Log your meals and symptoms. Spot patterns over time.</p></a><a href="/tools/elimination-diet-planner" class="group block bg-white border border-slate-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-300 no-underline"><div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-5 group-hover:bg-blue-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Elimination Diet Planner</h3><p class="text-sm text-slate-500 leading-relaxed">Plan a structured elimination diet with our guided template.</p></a><a href="/symptoms" class="group block bg-white border border-slate-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-300 no-underline"><div class="w-11 h-11 rounded-xl bg-rose-50 flex items-center justify-center mb-5 group-hover:bg-rose-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Symptoms</h3><p class="text-sm text-slate-500 leading-relaxed">Common food intolerance symptoms and what to watch for.</p></a><a href="/guides/test-guide" class="group block bg-white border border-slate-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-300 no-underline"><div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center mb-5 group-hover:bg-emerald-100 transition-colors"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div><h3 class="font-semibold text-slate-900 mb-2">Testing Guide</h3><p class="text-sm text-slate-500 leading-relaxed">Compare test types, accuracy, costs, and what doctors recommend.</p></a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-xs font-medium tracking-widest uppercase text-brand-600 mb-3">Common Questions</p>
          <h2 class="text-3xl font-semibold text-slate-900">What Do People Ask About Food Intolerance?</h2>
        </div>
        <div class="space-y-2" id="faq-list"></div>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl font-semibold text-slate-900 mb-5 text-center">What Does the Evidence Say?</h2>
        <div class="space-y-4">
          <blockquote class="border-l-4 border-brand-400 bg-white rounded-r-xl p-5 shadow-sm">
            <p class="text-sm text-slate-700 italic mb-2">"Food intolerance is a common condition that affects up to 20% of the population. Unlike food allergy, it does not involve the immune system and is generally not life-threatening."</p>
            <cite class="text-xs text-slate-500 not-italic">— NHS UK, Food Intolerance Overview (2024)</cite>
          </blockquote>
          <blockquote class="border-l-4 border-brand-400 bg-white rounded-r-xl p-5 shadow-sm">
            <p class="text-sm text-slate-700 italic mb-2">"The elimination diet followed by controlled reintroduction is considered the gold standard for identifying food intolerances. IgG testing is not recommended for this purpose."</p>
            <cite class="text-xs text-slate-500 not-italic">— British Dietetic Association (BDA), Food Intolerance Fact Sheet</cite>
          </blockquote>
          <blockquote class="border-l-4 border-brand-400 bg-white rounded-r-xl p-5 shadow-sm">
            <p class="text-sm text-slate-700 italic mb-2">"Approximately 70–80% of IBS patients experience significant symptom improvement on a low FODMAP diet when undertaken with professional guidance."</p>
            <cite class="text-xs text-slate-500 not-italic">— Monash University, Low FODMAP Diet Research</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-brand-50 to-emerald-50 border border-brand-200 rounded-2xl p-8 md:p-10 text-center">
          <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center mx-auto mb-4 shadow-sm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2 class="text-xl font-semibold text-brand-900 mb-3">Is This Tool a Medical Diagnosis?</h2>
          <p class="text-sm text-brand-700 max-w-xl mx-auto mb-5 leading-relaxed">No. This tool does NOT diagnose disease. It helps identify foods that may deserve further evaluation. Always consult your GP or a registered dietitian for medical advice. If you experience severe symptoms such as difficulty breathing, swelling, or anaphylaxis, seek emergency medical attention immediately.</p>
          <a href="/about" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-medium hover:bg-brand-700 transition-colors no-underline shadow-sm shadow-brand-200">Learn more about our approach<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "FoodCheck",
  "url": "https://foodintolerancecheck.com",
  "description": "Free online food intolerance self-assessment tools and evidence-based educational content.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://foodintolerancecheck.com/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FoodCheck",
  "url": "https://foodintolerancecheck.com",
  "logo": "https://foodintolerancecheck.com/favicon.svg",
  "description": "Free online food intolerance self-assessment tools and evidence-based educational content."
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Food Intolerance Checker",
  "url": "https://foodintolerancecheck.com/",
  "description": "A free online food intolerance self-assessment tool. Explore which foods may be linked to your symptoms. Educational tool only — no medical diagnosis.",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this checker a medical diagnosis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. This tool is for educational purposes only. Always consult your GP or a registered dietitian."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate is the checker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This checker uses common symptom patterns. It is not a validated diagnostic tool."
      }
    },
    {
      "@type": "Question",
      "name": "Food intolerance vs food allergy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Food intolerance affects the digestive system. Food allergy involves the immune system and can be life-threatening."
      }
    },
    {
      "@type": "Question",
      "name": "Are commercial tests reliable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Many IgG tests are not recommended by the NHS and BDA."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do with my results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Keep a food diary, try an elimination diet under professional guidance, and discuss with your GP."
      }
    }
  ]
}
</script>
<script is:inline src="/js/checker.js"></script>
</BaseLayout>